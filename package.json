{
  "name": "plexus-backend-trainer",
  "version": "1.0.0",
  "private": true,
  "description": "Tarjetero de estudio backend mobile-first, con sesiones reanudables y despliegue en Render",
  "scripts": {
    "start": "ng serve",
    "build": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "check:cards": "python tools/validate_cards.py",
    "test:logic": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:types:offline": "tsc --project tsconfig.offline-check.json",
    "check": "npm run check:cards && npm run test:logic && npm run build"
  },
  "dependencies": {
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@angular/service-worker": "~21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module"
}
